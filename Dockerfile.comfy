# ComfyUI コンテナ。Krea 2 / Z-Image など forge(lllyasviel backend)が
# 対応しないアーキ専用のバックエンドとして使う。
# SDXL/SD1.5/Flux は従来どおり forge 側で処理するため、こちらには載せない。
#
# GPU は sdui と共有する。同時に常駐すると 12GB では溢れるため、
# 生成の直列化と VRAM の明け渡しは forge 側の単一キューが制御する
# (forge: /sdapi/v1/unload-checkpoint / comfy: POST /router/free_vram)。
ARG CUDA_VERSION=12.8.1
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
# ComfyUI のバージョンは必ず固定する。Krea 2 は v0.26.0 以降でネイティブ対応。
ARG COMFY_REF=v0.33.3

RUN apt update && \
    apt install -y --no-install-recommends \
        git \
        python3 \
        python3-pip \
        python3-venv \
        libgl1 \
        libglib2.0-0 \
        ca-certificates \
        curl && \
    apt clean && rm -rf /var/lib/apt/lists/*

# ubuntu24.04 の python は PEP668 で外部管理扱いになり pip が拒否するため venv を使う。
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# torch は cu130 ホイールを明示的に入れる(requirements.txt の裸の `torch` に
# 解決させると CPU 版や別 CUDA 版が入りうる)。
#
# **cu128 だと ComfyUI の comfy_kitchen 最適化が丸ごと無効になる。**起動ログに
#   WARNING: You need pytorch with cu130 or higher to use optimized CUDA operations.
#   comfy_kitchen backend cuda: {'available': True, 'disabled': True}
# が出る。MiniMax-H3 では cu130 化で 2.4倍(27.5 -> 11.3 s/it)という実測がある。
#
# ホストドライバは 580.159.03 で CUDA 13.0 の要求(580.65.06 以上)を満たすため、
# cuda-compat-13-0 と LD_LIBRARY_PATH の細工は要らない(ドライバが古い環境では要る)。
# 3つとも同じ index から入れること。混ざると libcudart.so.13 not found で落ちる。
RUN pip install --no-cache-dir torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu130

RUN git clone https://github.com/comfyanonymous/ComfyUI /app/comfy && \
    cd /app/comfy && git checkout ${COMFY_REF}

RUN pip install --no-cache-dir -r /app/comfy/requirements.txt

# MiniMax-H3 を 12GB に載せるための外部ノード。両方ともリビジョンを固定する。
#
# ComfyUI-GGUF: GGUF 量子化の UNet / text encoder ローダ。H3 の素の重みは
#   DiT 21GB + TE 27GB で 3060 には載らない。`qwen3vl` は TXT_ARCH_LIST に入って
#   おり、`gguf_mmproj_loader` が同じディレクトリの mmproj を自動で拾って
#   vision タワーを繋ぐ(H3 の i2v は画像を vision ブロックとして条件付けに
#   差し込むので、これが無いと条件付けが壊れる)。
# ComfyUI-MiniMax-H3-Turbo: Turbo LoRA を 8 ステップで回すための専用サンプラー。
#   H3 は映像と音声を別のフローで進めるため、通常サンプラーだと音声が壊れる。
RUN git clone https://github.com/city96/ComfyUI-GGUF /app/comfy/custom_nodes/ComfyUI-GGUF && \
    cd /app/comfy/custom_nodes/ComfyUI-GGUF && \
    git checkout 6ea2651e7df66d7585f6ffee804b20e92fb38b8a && \
    pip install --no-cache-dir -r requirements.txt

RUN git clone https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo \
        /app/comfy/custom_nodes/ComfyUI-MiniMax-H3-Turbo && \
    cd /app/comfy/custom_nodes/ComfyUI-MiniMax-H3-Turbo && \
    git checkout a7624b4c00626a8ae7e78860769389d706565190

# モデルパス設定を焼き込む(compose のマウントを増やさない)
COPY comfy/extra_model_paths.yaml /app/comfy/extra_model_paths.yaml

# VRAM だけを返す解放エンドポイント(/api/router/free_vram)。forge のジョブが
# 挟まっても RAM 上の重みを捨てずに済ませるために使う。詳細はファイル内の説明。
COPY comfy/custom_nodes/ /app/comfy/custom_nodes/

# triton は起動時ではなく最初のカーネル JIT 時に C コンパイラを要求する。
# cu130 化で comfy_kitchen / triton の経路が有効になった結果、runtime イメージに
# gcc が無いと生成が
#   RuntimeError: Failed to find C compiler. Please specify via CC environment
#   variable or set triton.knobs.build.impl.
# で落ちる(cu128 のときは comfy_kitchen ごと無効だったので顕在化しなかった)。
# 依存の重いレイヤより後ろに置いてビルドキャッシュを壊さない。
# python3-dev は triton が Python.h を include するため必須(gcc だけでは
# fatal error: Python.h: No such file or directory で落ちる)。
# libcuda.so.1 は CDI がホストから注入するのでイメージ側に用意する必要はない。
RUN apt update && \
    apt install -y --no-install-recommends gcc g++ python3-dev && \
    apt clean && rm -rf /var/lib/apt/lists/*

# triton は起動時ではなく最初のカーネル JIT 時に C コンパイラを要求する。
# cu130 化で comfy_kitchen / triton の経路が有効になった結果、runtime イメージに
# gcc が無いと生成が
#   RuntimeError: Failed to find C compiler. Please specify via CC environment
#   variable or set triton.knobs.build.impl.
# で落ちる(cu128 のときは comfy_kitchen ごと無効だったので顕在化しなかった)。
# 依存の重いレイヤより後ろに置いてビルドキャッシュを壊さない。
RUN apt update && \
    apt install -y --no-install-recommends gcc g++ && \
    apt clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app/comfy

# モデルは A1111 レイアウト(/data = forge と共有)を extra_model_paths.yaml 経由で読む。
# 出力・入力・user データのみ comfy 専用ディレクトリに書く。
#
# --database-url を明示するのは、既定値が cli_args.py の位置から
# `<comfy>/user/comfyui.db` を組み立てており **--user-directory を無視する**ため。
# 未指定だとイメージ内に無い /app/comfy/user を開こうとして
# "Failed to initialize database ... unable to open database file" になる。
ENV COMFY_DATA=/data/comfy
# Z-Image の HiRes で確保ピークが跳ねた件の対策(断片化の緩和)。
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --cache-ram <active> <inactive>: ロード済みモデルを RAM に残す条件。
# 方針は「1アーキだけ常駐させる」。連続生成でディスクを読み直さないのが目的で、
# 複数アーキの同時常駐は狙わない(RAM が足りない。下記の収支を参照)。
#
# 既定のままだと1つも残らない。inactive 側の既定が「全 RAM 量」= 到達不可能な
# 目標のため、毎ノード実行後に未使用エントリの追い出しが必ず走る。前回使った
# モデルは次のプロンプト開始時点では未 fetch = inactive 扱いなので、ローダより
# 先に別のノードが実行されると捨てられ得る。空きが inactive 値を上回る間は
# 何も捨てないので、到達可能な値を明示する。
#
# 値は「1アーキ常駐時の空き」と「2アーキ常駐時の空き」の間に置く。
# 実測(全 62.7GiB): forge 16.4GiB(sd_checkpoints_keep_in_cpu で CPU 常駐) +
# comfy ベース ~4GiB + 1アーキ ~17GiB。
#   1アーキ = 38.0GiB 使用 -> 空き 24.7GiB   (閾値を上回るので残す)
#   2アーキ = 55.2GiB 使用 -> 空き  7.5GiB   (下回るので古い方を落とす)
# 逼迫時は既定と同じ挙動へ縮退するだけで壊れない。
# active 側は OOM を避けるハード下限(既定は RAM の10%)。
#
# 参考: --disable-mmap は試して効果が無かった(200.2s -> 203.6s)。重みの読み直しは
# mmap の問題ではなく、生成ごとに /api/free で DynamicVRAM のステージを捨てて
# いたのが原因だった。解放の遅延はルーター側(_install_lazy_release)で、解放時に
# RAM を捨てない件は custom_nodes/partial_vram_free.py で対処する。
EXPOSE 8188

CMD ["sh", "-c", "\
    mkdir -p $COMFY_DATA/output $COMFY_DATA/input $COMFY_DATA/temp $COMFY_DATA/user && \
    exec python3 main.py \
        --listen 0.0.0.0 --port 8188 \
        --extra-model-paths-config /app/comfy/extra_model_paths.yaml \
        --output-directory $COMFY_DATA/output \
        --input-directory $COMFY_DATA/input \
        --temp-directory $COMFY_DATA/temp \
        --user-directory $COMFY_DATA/user \
        --database-url sqlite:///$COMFY_DATA/user/comfyui.db \
        --cache-ram 6 16 \
"]
